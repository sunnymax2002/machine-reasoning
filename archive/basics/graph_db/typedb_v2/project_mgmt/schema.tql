define
    # Common attributes

    description sub attribute, value string;
    filepath sub attribute, value string;
    textId sub attribute, value string;
    numericId sub attribute, value long;
    name sub attribute, value string;
    email sub attribute, value string;
    title sub attribute, value string;

    # Entities

    # A user of the application
    User sub entity,
        owns name,
        owns email,
        owns textId;

    # A project is a collection of activities which has a well defined outcome, and optionally also a lifecycle
    Project sub entity;

    Milestone sub entity,
        owns title,
        owns description,
        owns numericId @key;

    # A task is an activity which is not large enough to qualify as a project, and can be owned and completed by a single person
    Task sub entity,
        owns title,
        owns description;

        # owns numericId @key,
        # owns title,
        # owns description,
        # owns filepath;  # Details e.g. code or image file

        # TODO: How to model parent-child relation, e.g., parent task for a given sub-task

    # Task dependency relationship
    depends-on sub relation,
        relates Task;

define
    # An entity that defines/specifies something, e.g. a requirement
    # TODO: Add a unique ID, perhaps using time based hash?
    Specification sub entity, abstract,
        owns title,
        owns description;

    # A Specifications may apply to multiple domains, e.g. Reset, Power management, etc.
    Domain sub entity,
        owns title,
        owns description;

    # A requirement which specifies what the solution must offer
    Requirement sub Specification;

    # Different types of requirements
    FunctionalRequirement sub Requirement;
    InterfaceRequirement sub Requirement;
    PerformanceRequirement sub Requirement;
    SecurityRequirement sub Requirement;

    # Feature and its Implementation to meet a requirement
    Feature sub Specification;
    Implementation sub Specification;

    # A testcase to verify the implementation
    Testcase sub Specification;

    # Change in a requirement, feature, implementation or testcase
    Change sub Specification;

    # A problem is a situation that needs to be solved
    Problem sub entity;

    # A problem may apply to one or more application areas, and systems are used in multiple applications
    Application sub entity,
        owns title,
        owns description;

    # System is a solution (e.g. a product, service etc.) that solves problems
    # System Component brings features to life. It is a part of a system
    System sub entity;
    # Product sub System;
    # Service sub System;

    # Different types of system components
    SoftwareComponent sub System;
    MechanicalComponent sub System;
    ElectricalComponent sub System;

    FirmwareComponent sub SoftwareComponent;
    ElectronicHardwareComponent sub ElectricalComponent;

    # Electronic Hardware Components can be manufacturing technology specific
    TechnologySpecificHardwareComponent sub ElectronicHardwareComponent;

    #######################################################################
    # Relations between Requirement, Feature, Implementation and Testcase #
    #######################################################################

    # A requirement is satisfied by a feature
    satisfies sub relation,
        relates satisfied,
        relates by;
    Requirement plays satisfies:satisfied;
    Feature plays satisfies:by;

    # A feature is implemented by an implementation
    implements sub relation,
        relates implemented,
        relates by;
    Feature plays implements:implemented;
    Implementation plays implements:by;

    # An implementation is verified by a testcase against a feature (reference)
    verifies sub relation,
        relates reference,
        relates verified,
        relates verifier;
    Feature plays verifies:reference;
    Implementation plays verifies:verified;
    Testcase plays verifies:verifier;
    
    # Derive from a baseline Definition
    # TODO: How to constraint that only the same type of Definition is derived from another Definition, e.g., Requirement is derived from Requirement and not from Specification
    derived-from sub relation,
        relates baseline,
        relates derivative,
        relates change;
    Specification plays derived-from:baseline;
    Specification plays derived-from:derivative;
    Change plays derived-from:change;

    # A System Component can also be derived from another Component
    # TODO: Should we separate the relation for Component and Specification? We don't want to populate the change attribute for Component, as it should be inferred from the Features which change in derived component
    System plays derived-from:baseline;
    System plays derived-from:derivative;

    # A System has multiple feature implementations, and could be made up of existing components
    composed-of sub relation,
        relates implementation,
        relates component;

    System plays composed-of:component;
    Implementation plays composed-of:implementation;

    # TODO: A component could derive partial functionality from another component, and implement the rest of the features. How to model this?
    # Can we say ComponentX derives from ComponentA and ComponentB, but does-not-support FeatureQ, and changes ImplementationK
    does-not-support sub relation,
        relates system,
        relates feature;
    System plays does-not-support:system;
    Feature plays does-not-support:feature;

    # System solves a problem
    solves sub relation,
        relates system,
        relates problem;
    System plays solves:system;
    Problem plays solves:problem;

    ## Rules ##

    # TODO: If a feature applies to a domain, then the implementation should also apply to the same domain - add such inference rules
    of-domain sub relation,
        relates specification,
        relates domain;
    Specification plays of-domain:specification;
    Domain plays of-domain:domain;

    # A requirement applies to one or more application areas
    applies-to sub relation,
        relates requirement,
        relates application;
    Requirement plays applies-to:requirement;
    Application plays applies-to:application;

    # A system may only be used in certain application
    used-in sub relation,
        relates system,
        relates application;
    System plays used-in:system;
    Application plays used-in:application;