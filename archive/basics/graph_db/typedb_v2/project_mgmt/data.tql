insert
	$r1 isa FunctionalRequirement, has title "Low Powr State";
	$r2 isa FunctionalRequirement, has title "High Performance State";

	$d1 isa Domain, has title "Power Management";
	$d2 isa Domain, has title "Performance";

	$rel1 (requirement: $r1, application: $a1) isa applies-to;
	$rel2 (requirement: $r2, application: $a2) isa applies-to;

	$a1 isa Application, has title "Mobile";
	$a2 isa Application, has title "Server";

	$rel3 (specification: $r2, domain: $d2) isa of-domain;
	$rel4 (specification: $r1, domain: $d1) isa of-domain;